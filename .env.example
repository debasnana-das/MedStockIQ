# Copy to .env for local development only. Never use these placeholders in deployment.
APP_ENV=development
# Replace with a unique random value of at least 32 bytes before running auth.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=replace-me-with-a-random-secret-at-least-32-characters
APP_NAME=MedStockIQ
POSTGRES_PASSWORD=local-dev-only-change-me
DATABASE_URL=postgresql+psycopg://medstockiq:local-dev-only-change-me@localhost:5432/medstockiq
UPLOAD_DIR=./data/uploads
